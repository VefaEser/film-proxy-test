{
  "name": "film-api-proxy",
  "main": "index.js",
  "compatibility_date": "2026-10-14",
  "keep_vars": true,
  "migrations_dir": "migrations",
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "IS_TEST_ENV": "false"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
